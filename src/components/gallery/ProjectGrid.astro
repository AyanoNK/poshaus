---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface ICarrousel {
  image: ImageMetadata;
  alt: string;
  slug: string;
}

interface Props {
  columns: ICarrousel[];
}

const { columns } = Astro.props;
---

<div class="grid grid-col-start-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
  {
    columns.map((column, index) => (
      <div>
        <a href={`/projects/${column.slug}`}>
          <Image
            src={column.image}
            alt={column.alt}
            widths={[480, 768, 1024]}
            sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 33vw"
            priority={index === 0}
            class="image"
          />
        </a>
      </div>
    ))
  }
</div>
