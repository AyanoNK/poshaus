---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const images = import.meta.glob<ImageMetadata>(
  "../../assets/illustrations/*.webp",
  { eager: true, import: "default" },
);

const illustration = (name: string, alt: string) => ({
  src: images[`../../assets/illustrations/${name}.webp`],
  alt,
});

const illustrationGrid = [
  [
    illustration(
      "narcissus_water_drop_small",
      "Illustration of a dark-haired girl falling through water toward pink light",
    ),
    illustration(
      "Water_dress_print",
      "Illustration of a woman whose flowing dress turns into the sea",
    ),
    illustration(
      "giorno_question_mark",
      "Illustration of Giorno Giovanna in a pink suit among red flowers",
    ),
    illustration(
      "warhammer_paladin",
      "Illustration of an armored paladin sitting on a red cape with a spear",
    ),
    illustration(
      "fox_girl",
      "Illustration of a girl with long blue braids riding a white fox",
    ),
    illustration(
      "tiger_linked_ingirl",
      "Illustration of a red tiger beside a woman in sunglasses",
    ),
    illustration(
      "agua1",
      "Illustration of abstract water reflections in orange, blue, and green",
    ),
    illustration(
      "poshaus_con_chica_black",
      "Illustration of a woman's face among mushrooms under a metal-style logo",
    ),
  ],
  [
    illustration(
      "Knight_sleepingsmall",
      "Illustration of a woman in silver armor resting among purple flowers",
    ),
    illustration(
      "Chica_le_da_el_sol_insta",
      "Illustration of a red-haired woman shading her eyes on a yellow background",
    ),
    illustration(
      "new_year_dragon",
      "Illustration of a teal Chinese dragon among clouds for the New Year",
    ),
    illustration(
      "front_chica_chest_tattoo2_3",
      "Illustration of a green-skinned woman in a red robe between two herons",
    ),
    illustration(
      "virgo_the_virrgin",
      "Illustration of a bearded man holding wine on a Virgo zodiac card",
    ),
    illustration(
      "agua3",
      "Illustration of abstract black swirls over gold contour lines",
    ),
    illustration(
      "agua4",
      "Illustration of layered waterfalls pouring over stepped stone ledges",
    ),
  ],
  [
    illustration(
      "sunmansmall",
      "Illustration of a towering figure in black armor with a blue sun head",
    ),
    illustration(
      "lady_lake_rgb",
      "Illustration of the Lady of the Lake holding a sword among water lilies",
    ),
    illustration(
      "magik",
      "Illustration of a long-haired blonde girl wielding a giant glowing sword",
    ),
    illustration(
      "ramen_soup_big",
      "Illustration of a girl with noodle hair sinking into a ramen bowl",
    ),
    illustration(
      "paper_hair",
      "Illustration of a woman's face with hair made of red paper ribbons",
    ),
    illustration(
      "fondo_agua",
      "Illustration of abstract teal and blue curves outlined in gold",
    ),
    illustration(
      "haku_2",
      "Illustration of Haku the white dragon before a red sun",
    ),
  ],
];
---

<div
  id="illustrations"
  class="relative flex flex-col items-center p-4 xl:p-10 bg-bluewave/50 scroll-smooth"
>
  <div class="grid grid-cols-3 justify-center justify-items-center gap-6 w-full m-0">
    {illustrationGrid.map((column) => (
      <div class="flex flex-col w-full gap-6">
        {column.map((image) => (
          <div class="image-container">
            <Image
              src={image.src}
              alt={image.alt}
              widths={[640, 768, 1024, 1280, 1536]}
              sizes="(max-width: 576px) 100vw, (max-width: 768px) 50vw, 33vw"
              class="image"
            />
          </div>
        ))}
      </div>
    ))}
  </div>
</div>

<style>
  @media (min-width: 0px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .title {
      font-size: var(--font-size-lg);
    }
  }
  @media (min-width: 576px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .title {
      font-size: var(--font-size-xl);
    }
  }
  @media (min-width: 768px) {
    .grid {
      max-width: 100%;
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  @media (min-width: 992px) {
    .grid {
    }
  }

  .image-container {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image {
    width: 105%;
    height: auto;
    -webkit-backface-visibility: hidden;
    -ms-transform: translateZ(0); /* IE 9 */
    -webkit-transform: translateZ(0); /* Chrome, Safari, Opera */
    transform: translateZ(0);
    transition: all 0.25s cubic-bezier(0.08, 0.59, 0.29, 0.99);
    border-radius: 0.15rem;
  }

  @media (min-width: 576px) {
    .image:is(:hover) {
      will-change: transform;
      transform: scale(1.04);
      z-index: 10;
    }
  }
</style>
