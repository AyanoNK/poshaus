---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface IGame {
  link: string;
  logo: ImageMetadata;
  logoAlt: string;
  concept: ImageMetadata;
  conceptAlt: string;
}

interface Props {
  columns: IGame[];
}
const { columns } = Astro.props;
---

<div class="grid">
  {columns.map((column, index) => (
    <a class="column" href={column.link} target="_blank">
      <div class="logo-container">
        <Image
          src={column.logo}
          alt={column.logoAlt}
          widths={[320, 640]}
          sizes="(max-width: 576px) 80vw, (max-width: 768px) 40vw, 27vw"
          priority={index === 0}
          class="image"
        />
      </div>
      <div class="concept-container">
        <Image
          src={column.concept}
          alt={column.conceptAlt}
          widths={[480, 768, 1024]}
          sizes="(max-width: 576px) 100vw, (max-width: 768px) 50vw, 33vw"
          class="image"
        />
      </div>
    </a>
  ))}
</div>
<style>
  .grid {
    width: 100%;
    display: grid;
    justify-items: center;
    grid-gap: 1rem;
    justify-content: center;
    grid-template-columns: 1fr 1fr 1fr;
  }

  .column {
    display: grid;
    grid-template-rows: 1fr 1fr;
    justify-items: center;
    align-items: center;
  }

  @media (min-width: 0px) {
    .grid {
      grid-template-columns: 1fr;
    }
    .title {
      font-size: var(--font-size-lg);
    }
  }
  @media (min-width: 576px) {
    .grid {
      grid-template-columns: 1fr 1fr;
    }
    .title {
      font-size: var(--font-size-xl);
    }
  }
  @media (min-width: 768px) {
    .grid {
      max-width: 100%;
      box-sizing: border-box;
      grid-template-columns: 1fr 1fr 1fr;
    }
  }

  @media (min-width: 1200px) {
    .grid {
      max-width: 1200px;
    }
  }

  @media (min-width: 1400px) {
    .grid {
      grid-gap: 2rem;
    }
  }

  .logo-container {
    width: 80%;
  }

  .image {
    width: 100%;
    height: auto;
    margin-bottom: 1rem;
    border-radius: 0.15rem;
  }
</style>
