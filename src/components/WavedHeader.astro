---
import { Image } from "astro:assets";
import BlueWave from "./BlueWave.astro";
import logo from "../assets/logo.png";
---

<div id="header" class="relative flex flex-col">
  <BlueWave class="absolute -z-10 opacity-50" />
  <div class="relative flex box-border w-full z-10 px-4">
    <div id="header-nav" class="flex items-center justify-center w-full pt-4">
      <a href="/">
        <Image
          src={logo}
          alt="Poshaus home"
          height={64}
          densities={[1, 2]}
          loading="eager"
          class="h-16 w-auto"
        />
      </a>
    </div>
  </div>
</div>
