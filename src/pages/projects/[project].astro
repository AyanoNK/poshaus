---
import { Image } from "astro:assets";
import GalleryLayout from "../../layouts/GalleryLayout.astro";
import bestivalCarrousel from "../../assets/projects/bestival/carrousel.webp";
import biliCarrousel from "../../assets/projects/bili/carrousel.webp";

export function getStaticPaths() {
  const pages = [
    {
      slug: "bestival",
      title: "Bestival",
      carrousel: bestivalCarrousel,
      carrouselAlt: "Bestival festival posters, passes, and artist cards with beast characters",
    },
    {
      slug: "bili",
      title: "Bili",
      carrousel: biliCarrousel,
      carrouselAlt: "Bili storybook pages of a curly-haired child playing and celebrating",
    },
  ];

  return pages.map((page) => ({
    params: { project: page.slug },
    props: page,
  }));
}

const { title, carrousel, carrouselAlt } = Astro.props;
---

<GalleryLayout title={title}>
  <div class="overflow-x-auto whitespace-nowrap w-full">
    <div class="min-w-max text-center">
      <Image
        src={carrousel}
        alt={carrouselAlt}
        height={560}
        densities={[1, 2]}
        priority
        class="h-[35rem] w-auto max-w-none"
      />
    </div>
  </div>
</GalleryLayout>

