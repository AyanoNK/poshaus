---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Image } from "astro:assets";
import GalleryLayout from "../../layouts/GalleryLayout.astro";
import { getProjects } from "../../lib/projects";

export const getStaticPaths = (async () => {
  const projects = await getProjects();
  return projects.flatMap(({ id, data }) =>
    data.gallery
      ? [
          {
            params: { project: id },
            props: { title: data.title, gallery: data.gallery },
          },
        ]
      : [],
  );
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { title, gallery } = Astro.props;
---

<GalleryLayout title={title}>
  <div class="overflow-x-auto whitespace-nowrap w-full">
    <div class="min-w-max text-center">
      <Image
        src={gallery.src}
        alt={gallery.alt}
        height={560}
        densities={[1, 2]}
        priority
        class="h-[35rem] w-auto max-w-none"
      />
    </div>
  </div>
</GalleryLayout>
